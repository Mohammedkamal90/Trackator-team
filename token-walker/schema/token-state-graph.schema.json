{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "token-state-graph.schema.json",
  "title": "token-state-graph (schema_version 1.5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "amm_selection",
    "report_outcome",
    "summary",
    "tool",
    "generated_at",
    "input",
    "config",
    "targets",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.5"
    },
    "report_outcome": {
      "enum": [
        "completes",
        "reverts"
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "parser",
        "node"
      ],
      "properties": {
        "name": {
          "const": "token-walker"
        },
        "version": {
          "type": "string"
        },
        "parser": {
          "type": "string"
        },
        "node": {
          "type": "string"
        }
      }
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "tree_sha256",
        "files"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxPathsPerEntry",
        "maxCallDepth",
        "maxSeqDepth",
        "maxSequences",
        "includePrivileged",
        "rawPaths",
        "maxConstraintSets",
        "envModel"
      ],
      "properties": {
        "maxPathsPerEntry": {
          "type": "integer",
          "minimum": 1
        },
        "maxCallDepth": {
          "type": "integer",
          "minimum": 1
        },
        "maxSeqDepth": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "maxSequences": {
          "type": "integer",
          "minimum": 1
        },
        "includePrivileged": {
          "type": "boolean"
        },
        "rawPaths": {
          "type": "boolean"
        },
        "maxConstraintSets": {
          "type": "integer",
          "minimum": 1
        },
        "envModel": {
          "type": "boolean"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warnings",
        "unresolved_calls",
        "unsupported_nodes",
        "truncated_entries",
        "parse_errors",
        "failed_files",
        "excluded_files",
        "incomplete_entries"
      ],
      "patternProperties": {
        ".*": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/target"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "targets"
      ],
      "properties": {
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "warnings",
            "unresolved",
            "unsupported",
            "truncated",
            "incomplete",
            "parse_errors",
            "failed_files"
          ],
          "properties": {
            "warnings": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "integer",
              "minimum": 0
            },
            "incomplete": {
              "type": "integer",
              "minimum": 0
            },
            "parse_errors": {
              "type": "integer",
              "minimum": 0
            },
            "failed_files": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contract",
              "report_outcome",
              "ledger_types",
              "balance_vars",
              "supply_vars",
              "rate_drivers",
              "pair_vars",
              "divergence_kinds",
              "sink_kinds",
              "access_counts",
              "entrypoints",
              "table_text",
              "sequences"
            ],
            "properties": {
              "contract": {
                "type": "string"
              },
              "report_outcome": {
                "enum": [
                  "completes",
                  "reverts"
                ]
              },
              "ledger_types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "balance_vars": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "supply_vars": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rate_drivers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pair_vars": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "divergence_kinds": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "sink_kinds": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "access_counts": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "table_text": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "entrypoints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "access",
                    "access_uncertain",
                    "mutability",
                    "paths",
                    "groups",
                    "divergence",
                    "sinks",
                    "status",
                    "incomplete_reasons"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "access": {
                      "type": "string"
                    },
                    "access_uncertain": {
                      "type": "boolean"
                    },
                    "mutability": {
                      "type": "string"
                    },
                    "paths": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "groups": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "divergence": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "sinks": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "status": {
                      "enum": [
                        "ok",
                        "INCOMPLETE"
                      ]
                    },
                    "incomplete_reasons": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "sequences": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "generated",
                  "kept",
                  "max_depth",
                  "top"
                ],
                "properties": {
                  "generated": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "kept": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max_depth": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "top": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "score",
                        "steps",
                        "incomplete",
                        "access_uncertain"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "score": {
                          "type": "number"
                        },
                        "steps": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "incomplete": {
                          "type": "boolean"
                        },
                        "access_uncertain": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "amm_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "models",
        "source"
      ],
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "v2",
              "v3",
              "v4"
            ]
          }
        },
        "source": {
          "enum": [
            "cli_argument",
            "interactive_user_input",
            "backward_compatible_default"
          ]
        }
      }
    }
  },
  "definitions": {
    "strarr": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "enum": [
        "definite",
        "inferred",
        "possible",
        "possible_param"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "file",
        "linearization",
        "token_model",
        "attacker_capabilities",
        "state_vars",
        "entrypoints",
        "env_model",
        "entrypoint_graph",
        "sequences",
        "divergence_sites",
        "sinks",
        "external_call_matrix",
        "amm_models"
      ],
      "properties": {
        "contract": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "linearization": {
          "$ref": "#/definitions/strarr"
        },
        "token_model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ledger_types",
            "balance_vars",
            "supply_vars",
            "rate_drivers",
            "allowance_vars",
            "fee_vars",
            "exclusion_vars",
            "pair_vars",
            "router_vars",
            "owner_vars",
            "treasury_vars",
            "mutex_vars",
            "toggle_vars",
            "threshold_vars",
            "balance_of_inputs",
            "evidence"
          ],
          "properties": {
            "ledger_types": {
              "$ref": "#/definitions/strarr"
            },
            "balance_vars": {
              "$ref": "#/definitions/strarr"
            },
            "supply_vars": {
              "$ref": "#/definitions/strarr"
            },
            "rate_drivers": {
              "$ref": "#/definitions/strarr"
            },
            "allowance_vars": {
              "$ref": "#/definitions/strarr"
            },
            "fee_vars": {
              "$ref": "#/definitions/strarr"
            },
            "exclusion_vars": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "var",
                  "subrole"
                ],
                "properties": {
                  "var": {
                    "type": "string"
                  },
                  "subrole": {
                    "type": "string"
                  }
                }
              }
            },
            "pair_vars": {
              "$ref": "#/definitions/strarr"
            },
            "router_vars": {
              "$ref": "#/definitions/strarr"
            },
            "owner_vars": {
              "$ref": "#/definitions/strarr"
            },
            "treasury_vars": {
              "$ref": "#/definitions/strarr"
            },
            "mutex_vars": {
              "$ref": "#/definitions/strarr"
            },
            "toggle_vars": {
              "$ref": "#/definitions/strarr"
            },
            "threshold_vars": {
              "$ref": "#/definitions/strarr"
            },
            "balance_of_inputs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "per_account_maps",
                "global_inputs"
              ],
              "properties": {
                "per_account_maps": {
                  "$ref": "#/definitions/strarr"
                },
                "global_inputs": {
                  "$ref": "#/definitions/strarr"
                }
              }
            },
            "evidence": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/strarr"
              }
            }
          }
        },
        "attacker_capabilities": {
          "$ref": "#/definitions/strarr"
        },
        "state_vars": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "contract",
              "type",
              "kind",
              "key_types",
              "value_type",
              "visibility",
              "constant",
              "immutable",
              "initial",
              "line",
              "file",
              "roles"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "contract": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "scalar",
                  "mapping",
                  "array",
                  "struct"
                ]
              },
              "key_types": {
                "$ref": "#/definitions/strarr"
              },
              "value_type": {
                "type": "string"
              },
              "visibility": {
                "type": "string"
              },
              "constant": {
                "type": "boolean"
              },
              "immutable": {
                "type": "boolean"
              },
              "initial": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "line": {
                "type": "integer"
              },
              "file": {
                "type": "string"
              },
              "roles": {
                "$ref": "#/definitions/strarr"
              }
            }
          }
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/entrypoint"
          }
        },
        "env_model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "assumptions",
            "pair_vars",
            "nodes"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "assumptions": {
              "$ref": "#/definitions/strarr"
            },
            "pair_vars": {
              "$ref": "#/definitions/strarr"
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "reads",
                  "writes"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "reads": {
                    "$ref": "#/definitions/strarr"
                  },
                  "writes": {
                    "$ref": "#/definitions/strarr"
                  }
                }
              }
            }
          }
        },
        "entrypoint_graph": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "via",
              "via_accounting"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "via": {
                "$ref": "#/definitions/strarr"
              },
              "via_accounting": {
                "$ref": "#/definitions/strarr"
              }
            }
          }
        },
        "sequences": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_depth",
            "total_generated",
            "kept",
            "collapsed_by",
            "truncated",
            "items"
          ],
          "properties": {
            "max_depth": {
              "type": "integer"
            },
            "total_generated": {
              "type": "integer"
            },
            "kept": {
              "type": "integer"
            },
            "collapsed_by": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "steps",
                  "length",
                  "score",
                  "links",
                  "touches",
                  "flags",
                  "equivalent_variants"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^SEQ-[0-9]{4,}$"
                  },
                  "steps": {
                    "$ref": "#/definitions/strarr"
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 2
                  },
                  "score": {
                    "type": "number"
                  },
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "from",
                        "to",
                        "via"
                      ],
                      "properties": {
                        "from": {
                          "type": "string"
                        },
                        "to": {
                          "type": "string"
                        },
                        "via": {
                          "$ref": "#/definitions/strarr"
                        }
                      }
                    }
                  },
                  "touches": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "divergence",
                      "sinks",
                      "accounting_vars"
                    ],
                    "properties": {
                      "divergence": {
                        "$ref": "#/definitions/strarr"
                      },
                      "sinks": {
                        "$ref": "#/definitions/strarr"
                      },
                      "accounting_vars": {
                        "$ref": "#/definitions/strarr"
                      }
                    }
                  },
                  "flags": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "involves_incomplete_entry",
                      "access_uncertain",
                      "contains_env",
                      "all_permissionless",
                      "repeatable_steps"
                    ],
                    "properties": {
                      "involves_incomplete_entry": {
                        "type": "boolean"
                      },
                      "access_uncertain": {
                        "type": "boolean"
                      },
                      "contains_env": {
                        "type": "boolean"
                      },
                      "all_permissionless": {
                        "type": "boolean"
                      },
                      "repeatable_steps": {
                        "$ref": "#/definitions/strarr"
                      }
                    }
                  },
                  "equivalent_variants": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "divergence_sites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "entry",
              "kind",
              "confidence",
              "basis",
              "line",
              "fn",
              "detail",
              "note",
              "group_count",
              "groups"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "entry": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "pair_balance_written_by_token_logic",
                  "implicit_balance_shift",
                  "supply_mutation",
                  "balance_credit_without_debit",
                  "balance_debit_without_credit",
                  "third_party_debit",
                  "contract_balance_triggered_sink",
                  "zero_slippage_swap"
                ]
              },
              "confidence": {
                "enum": [
                  "definite",
                  "inferred",
                  "possible"
                ]
              },
              "basis": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              },
              "fn": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "magnitude_hint": {
                "enum": [
                  "no_user_control",
                  "user_controlled_fee_scaled",
                  "user_controlled_unscaled"
                ]
              },
              "operand_params": {
                "$ref": "#/definitions/strarr"
              },
              "group_count": {
                "type": "integer",
                "minimum": 1
              },
              "groups": {
                "$ref": "#/definitions/strarr"
              }
            }
          }
        },
        "sinks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "entry",
              "kind",
              "line",
              "fn",
              "target",
              "call",
              "group_count",
              "groups"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "entry": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              },
              "fn": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "call": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "target_class": {
                "enum": [
                  "state_var",
                  "param",
                  "caller",
                  "this",
                  "constant",
                  "derived",
                  "unknown"
                ]
              },
              "zero_min_out": {
                "type": "boolean"
              },
              "group_count": {
                "type": "integer",
                "minimum": 1
              },
              "groups": {
                "$ref": "#/definitions/strarr"
              }
            }
          }
        },
        "external_call_matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "entry",
              "group_count",
              "line",
              "fn",
              "kind",
              "target",
              "target_class",
              "target_type",
              "function",
              "args",
              "value",
              "likely_view",
              "view_basis",
              "callback_surface",
              "state_writes_after_call",
              "mutex_guard"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "entry": {
                "type": "string"
              },
              "group_count": {
                "type": "integer"
              },
              "line": {
                "type": "integer"
              },
              "fn": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "external",
                  "native_transfer",
                  "native_send",
                  "low_level_call",
                  "delegatecall",
                  "staticcall",
                  "selfdestruct",
                  "create"
                ]
              },
              "target": {
                "type": "string"
              },
              "target_class": {
                "enum": [
                  "state_var",
                  "param",
                  "caller",
                  "this",
                  "constant",
                  "derived",
                  "unknown"
                ]
              },
              "target_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "function": {
